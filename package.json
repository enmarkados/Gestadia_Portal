{
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "start": "npm start --prefix backend",
    "build": "npm run build --prefix frontend",
    "deploy": "node ftp-deploy.cjs",
    "test": "playwright test",
    "app:dev": "npm run dev:app --prefix frontend",
    "app:build": "npm run build:app --prefix frontend",
    "app:preview": "npm run preview:app --prefix frontend",
    "mobile:sync": "npm run mobile:sync --prefix frontend",
    "mobile:ios": "npm run mobile:ios --prefix frontend",
    "mobile:android": "npm run mobile:android --prefix frontend",
    "mobile:run:ios": "npm run mobile:run:ios --prefix frontend",
    "mobile:run:android": "npm run mobile:run:android --prefix frontend",
    "mobile:assets": "npm run mobile:assets --prefix frontend"
  },
  "dependencies": {
    "basic-ftp": "^6.0.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^10.0.3",
    "playwright": "^1.60.0"
  }
}
