{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lidia:app:v2:responses:2.0-r4",
  "title": "APP v2 responses; locally exercised, activation separate",
  "$defs": {
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "detail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "detail",
        "correlation_id",
        "retryable"
      ]
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "enabled": {
          "type": "boolean"
        },
        "disabled_reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "consumed",
                "expired",
                "superseded",
                "capability_denied"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
      },
      "required": [
        "action_id",
        "label",
        "enabled",
        "disabled_reason",
        "expires_at"
      ]
    },
    "Presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "presentation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "presentation_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "single_choice",
            "confirmation",
            "information"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          },
          "maxItems": 20
        }
      },
      "required": [
        "presentation_id",
        "presentation_revision",
        "kind",
        "title",
        "description",
        "expires_at",
        "actions"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "information"
              }
            }
          },
          "then": {
            "properties": {
              "actions": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "actions": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "Support": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "none",
            "requested",
            "assigned",
            "in_support",
            "closed"
          ]
        },
        "operator_display_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "assigned_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attended_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
      },
      "required": [
        "status",
        "operator_display_name",
        "requested_at",
        "assigned_at",
        "attended_at",
        "updated_at"
      ]
    },
    "SondeoRequirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "declared",
            "supported",
            "contradicted",
            "not_applicable"
          ]
        },
        "evidence_message_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "maxItems": 20
        }
      },
      "required": [
        "requirement_id",
        "label",
        "status",
        "evidence_message_ids"
      ]
    },
    "SondeoResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "result_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "result_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "ruleset_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ruleset_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": [
            "collecting",
            "needs_clarification",
            "qualified",
            "not_qualified",
            "human_review",
            "stopped"
          ]
        },
        "evaluated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SondeoRequirement"
          },
          "maxItems": 50
        },
        "next_step": {
          "type": "string",
          "enum": [
            "continue",
            "clarify",
            "offer_checkout",
            "request_human",
            "none"
          ]
        }
      },
      "required": [
        "schema_version",
        "result_id",
        "result_revision",
        "ruleset_ref",
        "ruleset_version",
        "status",
        "evaluated_at",
        "summary",
        "requirements",
        "next_step"
      ]
    },
    "ReceiptResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "maxItems": 100
        },
        "presentation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "maxItems": 20
        },
        "sondeo_result_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sondeo_result_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "handoff_status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "requested",
                "assigned",
                "in_support",
                "closed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "appointment_receipt": {
          "$ref": "#/$defs/AppointmentReceipt"
        }
      },
      "required": [
        "message_ids",
        "presentation_ids",
        "sondeo_result_id",
        "sondeo_result_revision",
        "handoff_status"
      ]
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "operation": {
          "type": "string",
          "enum": [
            "session",
            "turn",
            "handoff",
            "context",
            "binding",
            "revocation",
            "message_receipt_ack"
          ]
        },
        "conversation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "processing",
            "completed",
            "failed",
            "outcome_unknown"
          ]
        },
        "receipt_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "state_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "retained_until": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReceiptResult"
            },
            {
              "$ref": "#/$defs/SessionAck"
            },
            {
              "$ref": "#/$defs/BindingAck"
            },
            {
              "$ref": "#/$defs/RevocationAck"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry_after_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "operation",
        "conversation_id",
        "turn_id",
        "status",
        "receipt_revision",
        "state_revision",
        "accepted_at",
        "updated_at",
        "completed_at",
        "retained_until",
        "result",
        "error",
        "retry_after_seconds"
      ]
    },
    "ReceiptLookup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "conversation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "state_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "receipt": {
          "$ref": "#/$defs/Receipt"
        }
      },
      "required": [
        "schema_version",
        "conversation_id",
        "state_revision",
        "receipt"
      ]
    },
    "Message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant",
            "operator",
            "event"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "presentation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Presentation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "message_id",
        "sequence",
        "occurred_at",
        "role",
        "text",
        "presentation"
      ]
    },
    "EffectiveAgent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "instruction_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "id",
        "display_name",
        "instruction_version"
      ]
    },
    "Timeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "conversation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          },
          "maxItems": 100
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "has_more": {
          "type": "boolean"
        },
        "conversation_status": {
          "type": "string",
          "enum": [
            "active",
            "waiting_for_support",
            "in_support",
            "closed"
          ]
        },
        "effective_agent": {
          "$ref": "#/$defs/EffectiveAgent"
        },
        "support": {
          "$ref": "#/$defs/Support"
        },
        "turn_statuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Receipt"
          },
          "maxItems": 101
        },
        "sondeo": {
          "anyOf": [
            {
              "$ref": "#/$defs/SondeoResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "last_message_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "conversation_id",
        "items",
        "next_cursor",
        "has_more",
        "conversation_status",
        "effective_agent",
        "support",
        "turn_statuses",
        "sondeo",
        "state_revision"
      ]
    },
    "ContextAck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "conversation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "context_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "current_context_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "state_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "persisted": {
          "const": true
        },
        "replayed": {
          "type": "boolean"
        },
        "effective_permissions": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sondeo",
              "history",
              "case_context",
              "commercial_handoff",
              "manager_handoff",
              "support_handoff",
              "crm_prepare",
              "callback_schedule"
            ]
          }
        },
        "applied_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "enforcement_deadline": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "enforcement_status": {
          "const": "propagating"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "current_profile_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      },
      "required": [
        "schema_version",
        "conversation_id",
        "operation_id",
        "context_revision",
        "current_context_revision",
        "state_revision",
        "persisted",
        "replayed",
        "effective_permissions",
        "applied_at",
        "enforcement_deadline",
        "enforcement_status",
        "correlation_id"
      ]
    },
    "MessageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "sequence",
        "turn_id",
        "role",
        "stored_at",
        "delivery_status",
        "received_at",
        "received_by",
        "read_at",
        "read_by",
        "receipt_revision"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "operator"
          ]
        },
        "stored_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "delivery_status": {
          "enum": [
            "sent",
            "received",
            "read"
          ]
        },
        "received_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "received_by": {
          "enum": [
            null,
            "agent",
            "operator",
            "account",
            "guest"
          ]
        },
        "read_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "read_by": {
          "enum": [
            null,
            "operator",
            "account",
            "guest"
          ]
        },
        "receipt_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "delivery_status": {
                "const": "sent"
              }
            }
          },
          "then": {
            "properties": {
              "received_at": {
                "type": "null"
              },
              "received_by": {
                "type": "null"
              },
              "read_at": {
                "type": "null"
              },
              "read_by": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "delivery_status": {
                "const": "received"
              }
            }
          },
          "then": {
            "properties": {
              "received_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              "received_by": {
                "enum": [
                  "agent",
                  "operator",
                  "account",
                  "guest"
                ]
              },
              "read_at": {
                "type": "null"
              },
              "read_by": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "delivery_status": {
                "const": "read"
              }
            }
          },
          "then": {
            "properties": {
              "received_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              "received_by": {
                "enum": [
                  "agent",
                  "operator",
                  "account",
                  "guest"
                ]
              },
              "read_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              "read_by": {
                "enum": [
                  "operator",
                  "account",
                  "guest"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "user"
              }
            }
          },
          "then": {
            "properties": {
              "received_by": {
                "enum": [
                  null,
                  "agent",
                  "operator"
                ]
              },
              "read_by": {
                "enum": [
                  null,
                  "operator"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "received_by": {
                "enum": [
                  null,
                  "account",
                  "guest"
                ]
              },
              "read_by": {
                "enum": [
                  null,
                  "account",
                  "guest"
                ]
              },
              "turn_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
