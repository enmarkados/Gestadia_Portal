{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lidia.gestadia.com/contracts/app-message-receipts-v1.schema.json",
  "title": "APP Message Receipts adenda 1.0",
  "$defs": {
    "MessageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "sequence",
        "turn_id",
        "role",
        "stored_at",
        "delivery_status",
        "received_at",
        "received_by",
        "read_at",
        "read_by",
        "receipt_revision"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "operator"
          ]
        },
        "stored_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "delivery_status": {
          "enum": [
            "sent",
            "received",
            "read"
          ]
        },
        "received_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "received_by": {
          "enum": [
            null,
            "agent",
            "operator",
            "account"
          ]
        },
        "read_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "read_by": {
          "enum": [
            null,
            "operator",
            "account"
          ]
        },
        "receipt_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "delivery_status": {
                "const": "sent"
              }
            }
          },
          "then": {
            "properties": {
              "received_at": {
                "type": "null"
              },
              "received_by": {
                "type": "null"
              },
              "read_at": {
                "type": "null"
              },
              "read_by": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "delivery_status": {
                "const": "received"
              }
            }
          },
          "then": {
            "properties": {
              "received_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              "received_by": {
                "enum": [
                  "agent",
                  "operator",
                  "account"
                ]
              },
              "read_at": {
                "type": "null"
              },
              "read_by": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "delivery_status": {
                "const": "read"
              }
            }
          },
          "then": {
            "properties": {
              "received_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              "received_by": {
                "enum": [
                  "agent",
                  "operator",
                  "account"
                ]
              },
              "read_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              },
              "read_by": {
                "enum": [
                  "operator",
                  "account"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "user"
              }
            }
          },
          "then": {
            "properties": {
              "received_by": {
                "enum": [
                  null,
                  "agent",
                  "operator"
                ]
              },
              "read_by": {
                "enum": [
                  null,
                  "operator"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "received_by": {
                "enum": [
                  null,
                  "account"
                ]
              },
              "read_by": {
                "enum": [
                  null,
                  "account"
                ]
              },
              "turn_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "MessageReceiptSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "conversation_id",
        "message_receipts_revision",
        "items"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "message_receipts_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/MessageReceipt"
          }
        }
      }
    },
    "MessageReceiptSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "conversation_id",
        "message_receipts_revision",
        "last_message"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "message_receipts_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "last_message": {
          "anyOf": [
            {
              "$ref": "#/$defs/LastMessage"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "LastMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "sequence",
        "role",
        "text",
        "occurred_at",
        "receipt"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "role": {
          "enum": [
            "user",
            "assistant",
            "operator",
            "event"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 4000
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/MessageReceipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "event"
              }
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "receipt": {
                "$ref": "#/$defs/MessageReceipt"
              }
            }
          }
        }
      ]
    },
    "MessageReceiptAckRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "ack_id",
        "state",
        "message_ids",
        "correlation_id"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "ack_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "state": {
          "enum": [
            "received",
            "read"
          ]
        },
        "message_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "MessageReceiptAckResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "conversation_id",
        "message_receipts_revision",
        "ack_id",
        "acked_at",
        "duplicate",
        "items"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "message_receipts_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "ack_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "acked_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "duplicate": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/MessageReceipt"
          },
          "minItems": 1
        }
      }
    },
    "PostIdempotencyHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Idempotency-Key"
      ],
      "properties": {
        "Idempotency-Key": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      }
    },
    "MessageReceiptQuery": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "message_ids"
          ],
          "properties": {
            "message_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turn_id"
          ],
          "properties": {
            "turn_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "const": true
            }
          }
        }
      ]
    }
  }
}
