{
  "name": "gestadia-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "test": "node --experimental-test-module-mocks --test --test-concurrency=1 src/*.test.js src/**/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "14.5.0",
    "helmet": "^8.1.0",
    "jose": "6.2.12",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "10.1.0",
    "prisma": "^6.1.0",
    "stripe": "^17.5.0"
  },
  "overrides": { "deepmerge-ts": "8.0.0" }
}
