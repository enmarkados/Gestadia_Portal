# --- Núcleo ---
PORT=3001
BASE_URL=http://localhost:3001
DATABASE_URL="mysql://gestadia:gestadia@localhost:3307/gestadia_dev"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- Stripe ---
# STRIPE_MODE elige qué claves se usan SIN tener que intercambiarlas:
#   dev → claves de PRUEBA (…_DEV): tarjeta de test 4242…, no cobra de verdad
#   pro → claves REALES (…_PRO): cobros reales (valor por defecto si se omite)
# Si las claves de un modo están vacías, ese modo funciona como DEMO (pago simulado).
STRIPE_MODE=dev
STRIPE_SECRET_KEY_DEV=
STRIPE_WEBHOOK_SECRET_DEV=
STRIPE_SECRET_KEY_PRO=
STRIPE_WEBHOOK_SECRET_PRO=

# --- Zoho CRM (datacenter EU) — un solo par de URLs para todo el backend ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
ZOHO_API_URL=https://www.zohoapis.eu
ZOHO_API_VERSION=v6
ZOHO_WEBHOOK_SECRET=cambia-esto-tambien

# --- Zoho: específico del flujo de leads informativos ---
ZOHO_LEAD_SOURCE_DEFAULT=Formulario Web
ZOHO_LEAD_STATUS_DEFAULT=No contactado
ZOHO_PAGE_SOURCE_DEFAULT=GESTADIA
ZOHO_CAMPAIGN_ID=
ZOHO_ASSIGNMENT_RULE_ID=

# --- Email transaccional ---
# Vacío = los emails se imprimen en consola (modo demo).
# El servidor real de Gestadia es mail.gestadia.com con la cuenta
# no_reply@gestadia.com (misma config en local y en producción: así los emails
# de prueba salen igual que los reales; no usar buzones tipo Ethereal).
SMTP_HOST=mail.gestadia.com
SMTP_PORT=587
SMTP_USER=no_reply@gestadia.com
SMTP_PASS=
EMAIL_FROM="Gestadia <no_reply@gestadia.com>"
# --- APP v1: asociación nativa adicional (apagada por defecto) ---
# Mantener APP_LIDIA_INTEGRATION_ID/AUDIENCE y claves existentes intactos.
# Las cinco KEY_ID nuevas deben ser únicas entre todas las integraciones LidIA.
# Las SECRET_BASE64 nativas opcionales usan, si están vacías, el secreto
# existente de la MISMA capacidad; nunca otro rol. Provisionar en privado.
APP_LIDIA_SONDEO_ENABLED=false
APP_LIDIA_SONDEO_INTEGRATION_ID=
APP_LIDIA_SONDEO_AUDIENCE=
APP_LIDIA_SONDEO_SESSION_KEY_ID=
APP_LIDIA_SONDEO_READ_KEY_ID=
APP_LIDIA_SONDEO_TURN_KEY_ID=
APP_LIDIA_SONDEO_CONTEXT_KEY_ID=
APP_LIDIA_SONDEO_REVOCATION_KEY_ID=
# Desactivar selección nueva conserva historial/retirada si el perfil sigue
# configurado. No incluye handoff ni permisos CRM/comercial/expediente.
