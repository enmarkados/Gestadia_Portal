generator client {
  provider      = "prisma-client-js"
  // native = desarrollo local (Windows); debian-openssl-1.1.x = el servidor
  // de gestadia.com (verificado por el engine instalado en su node_modules).
  // Permite generar localmente un cliente desplegable por FTP.
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  nombre        String
  apellidos     String
  telefono      String?
  tipoDocumento String?
  numDocumento  String?
  zohoContactId String?
  stripeCustomerId String?
  emailVerified Boolean   @default(false)
  accountStatus String @default("active")
  accountVerifiedAt DateTime?
  accountVerificationMethod String?
  inviteToken   String?   @unique
  resetToken    String?   @unique
  resetTokenExp DateTime?
  createdAt     DateTime  @default(now())

  accessRevokedAt DateTime?
  authSessions AuthSession[]
  socialIdentities SocialIdentity[]
  pushDevices PushDevice[]
  deletionRequest AccountDeletionRequest?

  expedientes    Expediente[]
  notificaciones Notificacion[]
  appDeviceSessions AppDeviceSession[]
  appConversations AppConversation[]
  appOperations AppOperation[]
  appConversationAccess AppConversationAccess[]
}

model Expediente {
  id               String    @id @default(uuid())
  nPedido          String    @unique
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  servicioSlug     String
  titulo           String
  estado           String    @default("pago_pendiente")
  faseZoho         String?
  zohoDealId       String?
  importe          Float
  moneda           String    @default("EUR")
  pagoRef          String?
  pagoMetodo       String?
  fechaPago        DateTime?
  finDesistimiento DateTime?
  paisCanje        String?
  direccion        Json?
  datosPais        Json?
  procedencia      String    @default("web")
  origenMeta       Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  documentos Documento[]
  eventos    EventoExpediente[]
}

model Documento {
  id           String     @id @default(uuid())
  expedienteId String
  expediente   Expediente @relation(fields: [expedienteId], references: [id])
  clave        String
  nombre       String
  mime         String
  size         Int
  path         String
  createdAt    DateTime   @default(now())
}

model EventoExpediente {
  id           String     @id @default(uuid())
  expedienteId String
  expediente   Expediente @relation(fields: [expedienteId], references: [id])
  estado       String
  nota         String?    @db.Text
  createdAt    DateTime   @default(now())
}

model Notificacion {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  expedienteId String?
  titulo       String
  cuerpo       String   @db.Text
  canal        String   @default("portal")
  pushDeliveries PushDelivery[]
  leida        Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model CheckoutIntent {
  id                    String   @id @default(uuid())
  publicId              String   @unique
  token                 String   @unique
  idempotencyKey        String   @unique
  payloadHash           String
  procedencia           String
  servicioSlug          String
  catalogCode           String
  amountMinor           Int
  currency              String   @default("EUR")
  lidiaPaymentId        String
  lidiaPaymentAttemptId String
  replacesId            String?
  prefill               Json
  origenMeta            Json
  estado                String   @default("active")
  expiresAt             DateTime
  expedienteId          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([lidiaPaymentId])
  @@index([estado, expiresAt])
}

model LidiaEvento {
  id               String    @id @default(uuid())
  eventId          String    @unique
  eventType        String
  checkoutIntentId String
  payload          String    @db.Text
  estado           String    @default("pendiente")
  intentos         Int       @default(0)
  proximoIntento   DateTime  @default(now())
  ultimaRespuesta  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([estado, proximoIntento])
}


model AuthSession {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id])
  platform String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  devices PushDevice[]
  @@index([userId, revokedAt])
}

model SocialIdentity {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  issuer String
  subject String
  provider String
  appleRefreshEncrypted String? @db.Text
  appleAudience String?
  appleRevokedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([issuer, subject])
  @@index([userId])
}

model SocialAuthAttempt {
  id String @id
  provider String
  platform String
  purpose String
  linkUserId String?
  authSessionId String?
  nonceHash String
  stateHash String @unique
  proofHash String
  audience String
  claims Json?
  appleRefreshEncrypted String? @db.Text
  status String @default("pending")
  handoffCodeHash String? @unique
  handoffExpiresAt DateTime?
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, expiresAt])
}

model PushDevice {
  id String @id @default(uuid())
  installationId String @unique
  userId String
  user User @relation(fields: [userId], references: [id])
  sessionId String
  session AuthSession @relation(fields: [sessionId], references: [id])
  transport String
  environment String
  tokenHash String @unique
  tokenEncrypted String @db.Text
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries PushDelivery[]
  @@index([userId, active])
}

model PushDelivery {
  id String @id @default(uuid())
  notificationId String
  notification Notificacion @relation(fields: [notificationId], references: [id])
  deviceId String
  device PushDevice @relation(fields: [deviceId], references: [id])
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  claimId String?
  lockedUntil DateTime?
  lastError String?
  createdAt DateTime @default(now())
  acceptedAt DateTime?
  @@unique([notificationId, deviceId])
  @@index([status, nextAttemptAt])
}

model AccountDeletionRequest {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  status String @default("pending_review")
  requestedAt DateTime @default(now())
  completedAt DateTime?
  @@index([status, requestedAt])
  result Json?
  contactEmailEncrypted String? @db.Text
  notificationStatus String @default("not_ready")
  notificationClaimId String?
  notificationLockedUntil DateTime?
  notificationAttempts Int @default(0)
  notificationNextAttempt DateTime?
  retainedDataEncrypted String? @db.LongText
  reviews AccountDeletionReview[]
}

model AccountDeletionReview {
  id String @id @default(uuid())
  requestId String
  request AccountDeletionRequest @relation(fields: [requestId], references: [id])
  action String @default("review")
  actorRef String
  authorityRef String
  inventoryHash String
  decision Json
  createdAt DateTime @default(now())
  @@index([requestId, createdAt])
}

model AppDeviceSession {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  tokenHash String @unique @db.VarChar(64)
  deviceLabel String @db.VarChar(80)
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  @@index([userId, revokedAt])
}

model AppConversation {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  integrationId String @db.VarChar(128)
  scopeKey String @db.VarChar(64)
  purpose String @db.VarChar(16)
  caseId String?
  title           String? @db.VarChar(120)
  remoteCreatedAt DateTime?
  lastMessageAt   DateTime?
  remoteId String? @db.VarChar(128)
  stateRevision String @default("0") @db.VarChar(20)
  status String @default("pending") @db.VarChar(32)
  contextRevision String @default("0") @db.VarChar(20)
  syncedRevision String @default("0") @db.VarChar(20)
  contextHash String? @db.VarChar(64)
  context Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  operations AppOperation[]
  @@index([userId, integrationId, scopeKey])
  @@unique([integrationId, remoteId])
}
model AppOperation {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  integrationId String @db.VarChar(128)
  conversationId String?
  conversation AppConversation? @relation(fields: [conversationId], references: [id])
  scopeId String @db.VarChar(36)
  kind String @db.VarChar(16)
  idempotencyKey String @db.VarChar(128)
  logicalId String? @db.VarChar(128)
  semanticHash String @db.VarChar(64)
  request Json
  status String @default("prepared") @db.VarChar(32)
  response Json?
  httpStatus Int?
  errorCode String? @db.VarChar(64)
  retainedUntil DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, integrationId, scopeId, kind, idempotencyKey])
  @@unique([userId, integrationId, scopeId, kind, logicalId])
  @@index([integrationId, kind, status])
}
model AppConversationAccess {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  scopeKey String @db.VarChar(64)
  purpose String @db.VarChar(16)
  caseId String?
  permissions Json
  commercialAssignmentRef String? @db.VarChar(128)
  managerAssignmentRef String? @db.VarChar(128)
  sourceRef String @db.VarChar(128)
  validatedAt DateTime
  validUntil DateTime
  @@unique([userId, scopeKey])
}
