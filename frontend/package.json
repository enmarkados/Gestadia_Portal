{
  "name": "gestadia-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:app": "vite --config vite.app.config.js",
    "build:app": "vite build --config vite.app.config.js",
    "preview:app": "vite preview --config vite.app.config.js",
    "mobile:sync": "npm run build:app && cap sync",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:run:ios": "npm run mobile:sync && cap run ios",
    "mobile:run:android": "npm run mobile:sync && cap run android",
    "mobile:assets": "npm exec --yes --package @capacitor/assets@3.0.5 -- capacitor-assets generate --assetPath assets --ios --android --iconBackgroundColor '#191919' --splashBackgroundColor '#181818' --splashBackgroundColorDark '#181818'",
    "mobile:release:prepare": "node ../scripts/mobile-release.mjs",
    "mobile:release:build": "node ../scripts/mobile-release.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.0.1",
    "@capacitor/browser": "8.0.0",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.1",
    "@capgo/capacitor-social-login": "8.5.13",
    "lucide-react": "1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "^25.0.1",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
