# El puerto del host solo recibe tráfico de Plesk (loopback).
map $http_x_forwarded_for $gestadia_client_chain {
  "" $remote_addr;
  default $http_x_forwarded_for;
}
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 11m;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options SAMEORIGIN always;

  location = /healthz { access_log off; default_type application/json; return 200 '{"ok":true,"app":"gestadia-portal-web"}'; }
  location = /build-info.json { add_header Cache-Control "no-store"; }
  location = /index.html { add_header Cache-Control "no-cache"; }
  location /assets/ { try_files $uri =404; expires 1y; add_header Cache-Control "public, immutable"; }
  location ~ ^/(api|webhooks)/ {
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $backend_upstream "${BACKEND_UPSTREAM}";
    proxy_pass $backend_upstream$request_uri;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $gestadia_client_chain;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_read_timeout 180s;
    proxy_next_upstream off;
    proxy_buffering off;
  }
  # Solo el endpoint autenticado entrega los documentos.
  location /uploads { return 404; }
  location / { try_files $uri $uri/ /index.html; }
}
